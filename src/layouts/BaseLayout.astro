---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  schema?: Record<string, any>;
  hideNavAndFooter?: boolean;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const {
  title = 'Dhirendra — Artist & Graphics Designer | Digital Art Gallery',
  description = 'Original fine art, contemporary paintings, charcoal portraiture, and selected creative visual design by Dhirendra (BVA, MVA). Winner of national and state recognitions.',
  ogImage = '/photos/awards/certificates%20and%20awards/438304121_950748996557945_5294600570921436411_n.jpg',
  canonicalUrl = Astro.url.href,
  type = 'website',
  schema,
  hideNavAndFooter = false,
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://dhirendra-art.vercel.app';
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

const defaultPersonSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Dhirendra',
  jobTitle: 'Artist & Graphics Designer',
  description: 'Accomplished artist with BVA & MVA degrees, over seven years of artistic practice, and national and state level recognitions.',
  url: siteUrl,
  knowsAbout: ['Fine Art', 'Oil Painting', 'Charcoal Portraiture', 'Graphic Design', 'Visual Composition', 'Scrap Metal Sculpture', 'Ceremonial Rangoli', 'Wall Murals'],
  alumniOf: [
    {
      '@type': 'EducationalOrganization',
      name: 'Faculty of Visual Arts, University of Lucknow (BVA & MVA)',
    },
  ],
};

const finalSchema = schema || defaultPersonSchema;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FBFBF9" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={absoluteOgImage} />

    <!-- LCP Preload if specified -->
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        imagesrcset={preloadImageSrcset}
        imagesizes={preloadImageSizes}
        fetchpriority="high"
      />
    )}

    <!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans (Non-render-blocking with font-display: swap) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
  </head>
  <body class="min-h-screen flex flex-col bg-[#FBFBF9] text-[#141311] selection:bg-[#141311] selection:text-[#FBFBF9]">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#141311] focus:text-[#FBFBF9] focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-[#9B4722] text-xs uppercase tracking-wider font-semibold"
    >
      Skip to main content
    </a>
    {!hideNavAndFooter && <Header />}
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    {!hideNavAndFooter && <Footer />}
  </body>
</html>
