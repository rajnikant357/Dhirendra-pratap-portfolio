<script>
  import { getSiteContent, hasCustomSiteContent } from '../lib/cmsStorage';
  function applyHomeContent() {
    try {
      if (!hasCustomSiteContent()) return;
      const content = getSiteContent();
      const heroHeadline = document.getElementById('cms-hero-headline');
      const heroSubtitle = document.getElementById('cms-hero-subtitle');
      const heroQuote = document.getElementById('cms-hero-quote');
      const heroDesc = document.getElementById('cms-hero-desc');
      const heroImg = document.getElementById('cms-hero-image') as HTMLImageElement;
      const homePortraitImg = document.getElementById('cms-home-about-portrait') as HTMLImageElement;

      if (heroHeadline && content.heroHeadline) heroHeadline.textContent = content.heroHeadline;
      if (heroSubtitle && content.heroSubtitle) heroSubtitle.textContent = content.heroSubtitle;
      if (heroQuote && content.heroQuote) heroQuote.textContent = content.heroQuote;
      if (heroDesc && content.heroDescription) heroDesc.textContent = content.heroDescription;
      if (heroImg && content.heroImage) heroImg.src = content.heroImage;
      if (homePortraitImg && content.aboutPortraitImage) homePortraitImg.src = content.aboutPortraitImage;

      // Featured Offer Showcase
      const featImg = document.getElementById('cms-featured-image') as HTMLImageElement;
      const featTitle = document.getElementById('cms-featured-title');
      const featSubtitle = document.getElementById('cms-featured-subtitle');
      const featLink = document.getElementById('cms-featured-link') as HTMLAnchorElement;
      const featBtn = document.getElementById('cms-featured-btn') as HTMLAnchorElement;

      if (featImg && content.featuredOfferImage) featImg.src = content.featuredOfferImage;
      if (featTitle && content.featuredOfferTitle) featTitle.textContent = content.featuredOfferTitle;
      if (featSubtitle && content.featuredOfferSubtitle) featSubtitle.textContent = content.featuredOfferSubtitle;
      if (featLink && content.featuredOfferLink) featLink.href = content.featuredOfferLink;
      if (featBtn && content.featuredOfferLink) featBtn.href = content.featuredOfferLink;
    } catch (e) {}
  }
  applyHomeContent();
  window.addEventListener('dhirendra_cms_updated', applyHomeContent);
</script>
