---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkCard from '../components/artwork/ArtworkCard.astro';
import HeroBackgroundSlideshow from '../components/hero/HeroBackgroundSlideshow.astro';
import { getAllArtworks, getFeaturedArtworks, getSignatureArtworks } from '../lib/artworks';
import { ACHIEVEMENTS_DATA } from '../lib/data/achievements';
import { PROJECTS_DATA } from '../lib/data/projects';
import { SERVICES_DATA, type ServiceItem } from '../lib/data/services';
import type { Artwork } from '../types/database';

const allArtworks = await getAllArtworks();
// Curated masterworks showcasing high-quality photography across paintings, drawings, scrap sculptures, and foam art
const coverflowArtworks: Artwork[] = [
  allArtworks.find((a) => a.id === 'art-01'),
  allArtworks.find((a) => a.id === 'art-07'),
  allArtworks.find((a) => a.id === 'art-02'),
  allArtworks.find((a) => a.id === 'art-10'),
  allArtworks.find((a) => a.id === 'art-08'),
  allArtworks.find((a) => a.id === 'art-11'),
  allArtworks.find((a) => a.id === 'art-14'),
  allArtworks.find((a) => a.id === 'art-12'),
].filter((a): a is Artwork => Boolean(a));

const featuredArtworks = await getFeaturedArtworks();
const signatureArtworks = await getSignatureArtworks();
const topAchievements = ACHIEVEMENTS_DATA.filter((a) => a.featured).slice(0, 4);
const selectedProjects = PROJECTS_DATA.filter((p) => p.featured).slice(0, 3);
const featuredServices: ServiceItem[] = [
  SERVICES_DATA.find((s) => s.id === 'wall-art-murals'),
  SERVICES_DATA.find((s) => s.id === 'traditional-rangoli'),
  SERVICES_DATA.find((s) => s.id === 'graphic-design-branding'),
].filter((s): s is ServiceItem => Boolean(s));
---

<BaseLayout
  title="Dhirendra — Artist & Graphics Designer | Official Portfolio & Digital Gallery"
  description="Official digital gallery of Dhirendra, Artist & Graphics Designer. BVA & MVA in Visual Arts, 7+ years practice. National and state award-winning paintings, drawings, and visual compositions."
  preloadImage="/photos/Work/CM%20Yogi/FB_IMG_1672659760788%20-%20Copy.webp"
  preloadImageSrcset="/photos/Work/CM%20Yogi/FB_IMG_1672659760788%20-%20Copy.thumb.webp 480w, /photos/Work/CM%20Yogi/FB_IMG_1672659760788%20-%20Copy.webp 720w"
  preloadImageSizes="100vw"
>
  <!-- 1. HERO: The Contemporary Exhibition Hall with CM Yogi & Awards Background Slideshow -->
  <section class="relative min-h-[92vh] flex items-center justify-center bg-[#FBFBF9] overflow-hidden border-b border-[#E8E5DC] py-16 lg:py-24">
    
    <!-- Background Slideshow running CM Yogi event pictures and award ceremonies -->
    <HeroBackgroundSlideshow />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Primary Identity & Positioning -->
        <div class="lg:col-span-6 space-y-6 bg-transparent p-6 sm:p-8 rounded-sm">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-transparent border border-white/60 rounded-full text-xs text-white">
            <span class="w-2 h-2 rounded-full bg-[#E5B84B] ring-1 ring-white/60"></span>
            <span class="uppercase tracking-[0.16em] font-bold text-[11px] text-white drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)]">Official Digital Catalogue &amp; Portfolio</span>
          </div>

          <div class="space-y-2">
            <h1 id="cms-hero-headline" class="font-serif-display text-5xl sm:text-7xl lg:text-8xl text-white font-bold tracking-tight leading-[0.95] drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
              Dhirendra
            </h1>
            <p id="cms-hero-subtitle" class="text-xs sm:text-sm uppercase tracking-[0.26em] text-white font-bold drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]">
              Artist & Graphics Designer
            </p>
          </div>

          <p id="cms-hero-quote" class="font-serif text-xl sm:text-2xl text-white leading-relaxed italic max-w-xl font-bold drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]">
            Creating art that connects observation, imagination, and expression.
          </p>

          <p id="cms-hero-desc" class="text-sm sm:text-base text-white leading-relaxed max-w-xl font-bold drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]">
            An accomplished artist with an academic background in BVA and MVA (Department of Fine Arts, University of Lucknow), more than seven years of dedicated studio practice, and honors across national, state, and civic platforms.
          </p>

          <!-- CTAs -->
          <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <a
              href="/gallery"
              class="px-7 py-3.5 bg-[#141311] text-[#FBFBF9] hover:bg-[#2C2A26] border border-white/30 text-xs uppercase tracking-[0.2em] font-bold transition-all duration-300 text-center shadow-md hover:shadow-lg"
            >
              Explore Works &rarr;
            </a>
            <a
              href="/awards"
              class="px-7 py-3.5 bg-[#B68B35] text-[#141311] hover:bg-[#A37B2B] text-xs uppercase tracking-[0.2em] font-bold transition-all duration-300 text-center shadow-sm"
            >
              Awards &amp; Press &rarr;
            </a>
            <a
              href="/about"
              class="px-6 py-3.5 bg-white/90 border border-white text-[#141311] hover:bg-[#141311] hover:text-[#FBFBF9] text-xs uppercase tracking-[0.2em] font-bold transition-all duration-300 text-center backdrop-blur-xs"
            >
              The Artist
            </a>
          </div>

          <!-- Credential Micro-Badges -->
          <div class="pt-6 border-t border-white/40 grid grid-cols-3 gap-4 text-left">
            <div>
              <span class="block font-serif text-2xl font-bold text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]">7+</span>
              <span class="text-[11px] uppercase tracking-wider text-white font-bold drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]">Years Practice</span>
            </div>
            <div>
              <span class="block font-serif text-2xl font-bold text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]">BVA & MVA</span>
              <span class="text-[11px] uppercase tracking-wider text-white font-bold drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]">Visual Arts</span>
            </div>
            <div>
              <span class="block font-serif text-2xl font-bold text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]">National</span>
              <span class="text-[11px] uppercase tracking-wider text-white font-bold drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]">& State Honors</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Hero Visual Artwork Focal Point -->
        <div class="lg:col-span-6">
          <div class="relative max-w-lg mx-auto lg:max-w-none">
            <!-- Asymmetrical background matting -->
            <div class="absolute -inset-4 bg-[#F4F1EA] rounded-sm transform rotate-1 transition-transform group-hover:rotate-0"></div>
            
            <div class="relative bg-white p-4 sm:p-6 rounded-sm shadow-xl border border-[#E8E5DC]">
              <a
                href="/gallery/artistic-presentation-dgp-up-police"
                class="block relative aspect-[4/5] overflow-hidden bg-[#E8E5DC] group/heroimg cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#9B4722]"
                aria-label="View details of Artistic Portfolio Presentation to DGP (UP Police)"
              >
                <picture>
                  <source
                    srcset="/photos/awards/certificates%20and%20awards/438304121_950748996557945_5294600570921436411_n.thumb.webp 640w, /photos/awards/certificates%20and%20awards/438304121_950748996557945_5294600570921436411_n.webp 1080w"
                    sizes="(max-width: 640px) 90vw, 600px"
                    type="image/webp"
                  />
                  <img
                    id="cms-hero-image"
                    src="/photos/awards/certificates%20and%20awards/438304121_950748996557945_5294600570921436411_n.thumb.webp"
                    srcset="/photos/awards/certificates%20and%20awards/438304121_950748996557945_5294600570921436411_n.thumb.webp 640w, /photos/awards/certificates%20and%20awards/438304121_950748996557945_5294600570921436411_n.jpg 1080w"
                    sizes="(max-width: 640px) 90vw, 600px"
                    alt="Artistic portfolio presentation to the DGP (UP Police) by visual artist Dhirendra Pratap"
                    width="600"
                    height="750"
                    loading="lazy"
                    fetchpriority="auto"
                    decoding="async"
                    class="w-full h-full object-cover object-center transform transition-transform duration-700 ease-out group-hover/heroimg:scale-105"
                  />
                </picture>
                <div class="absolute inset-0 bg-[#141311]/0 group-hover/heroimg:bg-[#141311]/10 transition-colors duration-300"></div>
              </a>

              <!-- Artwork Plaque underneath -->
              <div class="pt-4 flex items-center justify-between border-t border-[#F0ECE3] mt-4">
                <div>
                  <h2 class="font-serif-display text-lg text-[#141311] font-medium">
                    Artistic Presentation to DGP (UP Police)
                  </h2>
                  <p class="text-xs text-[#6B6864] italic font-serif">
                    UP Police Headquarters &bull; Lucknow &bull; 2024
                  </p>
                </div>
                <a
                  href="/gallery/artistic-presentation-dgp-up-police"
                  class="text-xs uppercase tracking-[0.16em] text-[#9B4722] hover:text-[#7D3516] font-semibold underline underline-offset-4"
                >
                  View Details &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. THE ARTIST BEHIND THE CANVAS -->
  <section class="py-24 bg-white border-b border-[#E8E5DC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Studio Portrait / Visual Atmosphere -->
        <div class="lg:col-span-5 order-2 lg:order-1">
          <div class="relative bg-[#F4F1EA] p-3 sm:p-4 rounded-sm border border-[#E8E5DC]">
            <a
              href="/about"
              class="block relative aspect-[3/4] overflow-hidden bg-[#E8E5DC] group/studio cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#9B4722]"
              aria-label="Discover the Artist's Story"
            >
              <picture>
                <source
                  srcset="/photos/Dhirendra.thumb.webp 427w, /photos/Dhirendra.webp 1024w"
                  sizes="(max-width: 640px) 427px, 480px"
                  type="image/webp"
                />
                <img
                  id="cms-home-about-portrait"
                  src="/photos/Dhirendra.thumb.webp"
                  srcset="/photos/Dhirendra.thumb.webp 427w, /photos/Dhirendra.jpeg 1024w"
                  sizes="(max-width: 640px) 427px, 480px"
                  alt="Studio portrait of artist Dhirendra Pratap"
                  width="480"
                  height="640"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover object-top transform transition-transform duration-700 group-hover/studio:scale-105"
                />
              </picture>
              <div class="absolute inset-0 bg-[#141311]/0 group-hover/studio:bg-[#141311]/10 transition-colors duration-300"></div>
            </a>
            <div class="pt-3 text-[11px] text-[#8A857D] text-center font-mono uppercase tracking-wider">
              Studio Practice &bull; University of Lucknow &bull; Fine Arts Archive
            </div>
          </div>
        </div>

        <!-- Curatorial Narrative -->
        <div class="lg:col-span-7 order-1 lg:order-2 space-y-6">
          <span class="text-xs uppercase tracking-[0.24em] text-[#B68B35] font-semibold block">
            Artistic Heritage & Practice
          </span>
          <h2 class="font-serif-display text-4xl sm:text-5xl text-[#141311] font-medium leading-tight">
            The Artist Behind the Canvas
          </h2>

          <p class="text-base text-[#57544E] leading-relaxed">
            Dhirendra Pratap’s creative journey is rooted in deep academic discipline, completed through the Department of Fine Arts, Faculty of Arts, <strong>University of Lucknow (MVA)</strong>. With over seven years of dedicated studio and on-site practice across Uttar Pradesh, his work bridges classical Indian draftsmanship with bold contemporary execution.
          </p>

          <p class="text-base text-[#57544E] leading-relaxed">
            His multidisciplinary practice encompasses large-scale acrylic paintings, observational graphite portraiture, monumental recycled scrap metal sculptures, traditional and civic wall murals, and ceremonial rangolis. Affirmed through national workshop participation with the <strong>Lalit Kala Akademi</strong> (Ministry of Culture), state cultural honors including the <strong>Uttar Pradesh Kala Ratna</strong> and <strong>Kala Shree Samman</strong>, Dhirendra’s work investigates form, material permanence, and civic consciousness.
          </p>

          <div class="pt-4">
            <a
              href="/about"
              class="inline-flex items-center text-xs uppercase tracking-[0.2em] text-[#141311] hover:text-[#9B4722] font-semibold pb-1 border-b-2 border-[#141311] hover:border-[#9B4722] transition-colors"
            >
              Read His Story & Detailed Biography &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. TOP MASTERWORKS: 4 Grid 2 Row Images Section -->
  <section class="py-24 bg-[#FBFBF9] border-b border-[#E8E5DC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between pb-8 border-b border-[#E8E5DC] gap-6">
        <div>
          <span class="text-xs uppercase tracking-[0.22em] text-[#9B4722] font-semibold block">
            Curated Exhibition Stage
          </span>
          <h2 class="font-serif-display text-4xl sm:text-5xl text-[#141311] font-medium mt-1">
            Top Masterworks
          </h2>
          <p class="text-sm text-[#6B6864] mt-2 max-w-2xl">
            A curated showcase of masterworks across fine art paintings, monumental scrap sculptures, foam art, and civic murals. Scroll, swipe, or use controls to explore the collection.
          </p>
        </div>

        <a
          href="/gallery"
          class="inline-flex items-center px-6 py-3 border border-[#141311] text-[#141311] hover:bg-[#141311] hover:text-[#FBFBF9] text-xs uppercase tracking-[0.2em] font-medium transition-all shrink-0"
        >
          View Full Catalogue &rarr;
        </a>
      </div>

      <!-- 4 Grid 2 Row Images Section -->
      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        {coverflowArtworks.map((artwork) => (
          <ArtworkCard artwork={artwork} priority={false} />
        ))}
      </div>

    </div>
  </section>

  <!-- 4. ARTISTIC JOURNEY: Elegant Timeline -->
  <section class="py-24 bg-white border-b border-[#E8E5DC]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-[0.22em] text-[#B68B35] font-semibold block">
          Chronology of Dedication
        </span>
        <h2 class="font-serif-display text-4xl sm:text-5xl text-[#141311] font-medium mt-1">
          The Artistic Journey
        </h2>
        <p class="text-sm text-[#6B6864] mt-2">
          Grounded in classical academy training, evolved through intensive studio experimentation, and affirmed through national honors.
        </p>
      </div>

      <!-- Timeline Structure -->
      <div class="relative border-l-2 border-[#E8E5DC] ml-4 sm:ml-32 space-y-12 pl-6 sm:pl-10">
        
        <!-- Step 1: Academic Immersion & University Training -->
        <div class="relative">
          <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#141311] border-4 border-white"></span>
          <span class="text-xs uppercase tracking-[0.16em] text-[#9B4722] font-mono block">2015–2021 &bull; Academic Rigor (BVA &amp; MVA)</span>
          <h3 class="font-serif-display text-2xl text-[#141311] font-medium mt-0.5">
            Department of Fine Arts, University of Lucknow
          </h3>
          <p class="text-sm text-[#57544E] mt-1">
            Rigorous studio immersion in observational drawing, classical Indian iconography, human anatomy, and painting composition. Integrated digital visual computing with Taxtron (2017) and led public environmental art for Climate Agenda's 'Clean Air Gomti' campaign (2018).
          </p>
        </div>

        <!-- Step 3: Pandemic Frontline Art & State Accolades -->
        <div class="relative">
          <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#B68B35] border-4 border-white"></span>
          <span class="text-xs uppercase tracking-[0.16em] text-[#B68B35] font-mono block">2020 &bull; Frontline Public Art &amp; State Honors</span>
          <h3 class="font-serif-display text-2xl text-[#141311] font-medium mt-0.5">
            Uttar Pradesh Kala Ratna &amp; Kala Shree Samman
          </h3>
          <p class="text-sm text-[#57544E] mt-1">
            Pioneered monumental street rangolis and murals across Lucknow (Mankameshwar Temple, Hazratganj, and Raj Bhavan) honoring healthcare and frontline personnel. Felicitated by North Lucknow ACP Sonam Kumar and UP Police, and awarded the Uttar Pradesh Kala Ratna and Kala Shree Samman.
          </p>
        </div>

        <!-- Step 4: National Apex Workshop & Historical Wall Map -->
        <div class="relative">
          <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#B68B35] border-4 border-white"></span>
          <span class="text-xs uppercase tracking-[0.16em] text-[#B68B35] font-mono block">2021–2022 &bull; National Workshop &amp; University Citation</span>
          <h3 class="font-serif-display text-2xl text-[#141311] font-medium mt-0.5">
            Lalit Kala Akademi National Workshop &amp; South Asia Wall Map
          </h3>
          <p class="text-sm text-[#57544E] mt-1">
            Conferred Shan-e-Siddharth Samman at Kapilvastu Mahotsav. Selected for Lalit Kala Akademi's 'Har Ghar Tiranga' National Painting Workshop (Ministry of Culture, Govt. of India). Awarded official citation by University of Lucknow for hand-painting the monumental South Asia Historical Wall Map.
          </p>
        </div>

        <!-- Step 5: Ayodhya Murals, Scrap Metal Sculptures & CM Presentations -->
        <div class="relative">
          <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#9B4722] border-4 border-white"></span>
          <span class="text-xs uppercase tracking-[0.16em] text-[#9B4722] font-mono block">2023–2024 &bull; Civic Murals, Scrap Sculptures &amp; CM Honors</span>
          <h3 class="font-serif-display text-2xl text-[#141311] font-medium mt-0.5">
            Ayodhya Ramayana Murals, Scrap Lion &amp; CM Presentations
          </h3>
          <p class="text-sm text-[#57544E] mt-1">
            Executed large-scale Ramayana heritage murals in Ayodhya and urban civic corridors. Fabricated landmark eco-sculptures from industrial scrap, including the life-sized Scrap Lion and Transformer Robot. Presented commissioned portraits directly to Hon'ble UP Chief Minister Yogi Adityanath.
          </p>
        </div>

        <!-- Step 6: Ongoing Studio & Nationwide Commissions -->
        <div class="relative">
          <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#141311] border-4 border-white"></span>
          <span class="text-xs uppercase tracking-[0.16em] text-[#141311] font-mono block">Present &bull; Studio &amp; Commission Practice</span>
          <h3 class="font-serif-display text-2xl text-[#141311] font-medium mt-0.5">
            Nationwide Architectural Murals, Fine Art &amp; Brand Direction
          </h3>
          <p class="text-sm text-[#57544E] mt-1">
            Active multidisciplinary studio executing high-durability wall art, recycled metal sculptures, ceremonial stage scenography, VIP floor rangolis, and brand graphics for governmental institutions, corporate patrons, and private collectors.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- 5. RECOGNITION & ACHIEVEMENTS: Major Credibility Section -->
  <section class="py-24 bg-[#FAF5E9] border-b border-[#E8E5DC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between pb-12 border-b border-[#E8E5DC] gap-6">
        <div>
          <span class="text-xs uppercase tracking-[0.22em] text-[#B68B35] font-semibold block">
            Verified Accolades
          </span>
          <h2 class="font-serif-display text-4xl sm:text-5xl text-[#141311] font-medium mt-1">
            Recognition & Achievements
          </h2>
          <p class="text-sm text-[#57544E] mt-2 max-w-xl">
            Affirmation of artistic excellence across national academies, state cultural councils, and government administration.
          </p>
        </div>

        <a
          href="/awards#recognition"
          class="text-xs uppercase tracking-[0.18em] text-[#141311] hover:text-[#9B4722] font-semibold underline underline-offset-4"
        >
          View Full Achievements, Awards &amp; Press &rarr;
        </a>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {topAchievements.map((ach) => (
          <div class="bg-white p-6 rounded-sm border border-[#E8E5DC] flex flex-col justify-between hover:shadow-md transition-shadow space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs">
                <span class="px-2 py-0.5 bg-[#FAF5E9] border border-[#E8E5DC] text-[#9B4722] font-medium uppercase tracking-wider text-[10px]">
                  {ach.category}
                </span>
                <span class="font-mono text-[#8A857D]">{ach.year}</span>
              </div>
              <h3 class="font-serif-display text-xl text-[#141311] font-medium leading-snug">
                {ach.title}
              </h3>
              <p class="text-xs text-[#6B6864] font-medium">
                {ach.organization} {ach.location ? `• ${ach.location}` : ''}
              </p>
              <p class="text-xs text-[#57544E] leading-relaxed pt-1">
                {ach.description}
              </p>
            </div>

            {ach.image_path && (
              <div class="pt-2">
                <a
                  href="/awards#recognition"
                  class="block aspect-[16/10] bg-[#F0ECE3] rounded-sm overflow-hidden border border-[#E8E5DC] group cursor-pointer"
                  title={`View ${ach.title} certificate`}
                >
                  <picture>
                    <source srcset={ach.image_path.replace(/\.(jpg|jpeg|png)$/i, '.thumb.webp')} type="image/webp" />
                    <img
                      src={ach.image_path}
                      alt={`${ach.title} certificate / honor`}
                      width="400"
                      height="250"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </picture>
                </a>
              </div>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 5B. FEATURED STUDIO SERVICES: Wall Art, Rangoli & Graphic Design -->
  <section class="py-24 bg-white border-b border-[#E8E5DC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between pb-10 border-b border-[#E8E5DC] gap-6">
        <div>
          <h2 class="font-serif-display text-4xl sm:text-5xl text-[#141311] font-medium">
            Studio Services &amp; Commissions
          </h2>
        </div>

        <a
          href="/services"
