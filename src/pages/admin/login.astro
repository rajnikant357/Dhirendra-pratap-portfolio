---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Studio CMS Login — Dhirendra Art Gallery"
  description="Curatorial and administrative access portal for managing artworks, collector offers, and consignment orders."
>
  <div class="min-h-[75vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 bg-[#FBFBF9]">
    <div class="max-w-md w-full bg-white p-8 sm:p-10 border border-[#E8E5DC] rounded-sm shadow-sm space-y-6">
      
      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-[0.2em] text-[#9B4722] font-semibold">
          Studio Administration
        </span>
        <h1 class="font-serif-display text-3xl sm:text-4xl text-[#141311] font-medium">
          Dhirendra Studio CMS
        </h1>
        <p class="text-xs text-[#6B6864]">
          Sign in to manage catalogue artworks, review offers, and update orders.
        </p>
      </div>

      <form id="admin-login-form" class="space-y-4">
        <div>
          <label class="block text-xs uppercase tracking-wider text-[#57544E] mb-1 font-medium">
            Admin Email Address
          </label>
          <input
            type="email"
            id="admin-email"
            required
            placeholder="curator@dhirendra-art.in"
            class="w-full px-3.5 py-2.5 text-sm bg-[#FBFBF9] border border-[#D3CEBF] rounded-sm focus:outline-none focus:ring-1 focus:ring-[#9B4722]"
          />
        </div>

        <div>
          <label class="block text-xs uppercase tracking-wider text-[#57544E] mb-1 font-medium">
            Password
          </label>
          <input
            type="password"
            id="admin-password"
            required
            placeholder="••••••••••••"
            class="w-full px-3.5 py-2.5 text-sm bg-[#FBFBF9] border border-[#D3CEBF] rounded-sm focus:outline-none focus:ring-1 focus:ring-[#9B4722]"
          />
        </div>

        <div class="pt-2">
          <button
            type="submit"
            class="w-full py-3 bg-[#141311] hover:bg-[#2C2A26] text-[#FBFBF9] text-xs uppercase tracking-[0.2em] font-medium transition-colors"
          >
            Enter Studio Dashboard &rarr;
          </button>
        </div>
      </form>

      <!-- Demo Access Note -->
      <div class="p-3 bg-[#FAF5E9] border border-[#E8E5DC] rounded-sm text-xs text-[#57544E] space-y-1">
        <span class="font-semibold text-[#141311] block">Studio Demo Access:</span>
        <p class="text-[11px] text-[#6B6864]">
          You can test the Studio CMS by clicking the dashboard link directly below:
        </p>
        <a
          href="/admin/dashboard"
          class="inline-block text-xs text-[#9B4722] hover:text-[#7D3516] font-semibold underline underline-offset-4 pt-1"
        >
          Open Admin Dashboard Overview &rarr;
        </a>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('admin-login-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // Route to admin dashboard
      window.location.href = '/admin/dashboard';
    });
  }
</script>
