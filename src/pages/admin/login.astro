---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Studio CMS Portal Sign In — Dhirendra Art Gallery"
  description="Owner and curatorial administrative portal for managing artworks, uploading content, reviewing collector offers, and consignment orders."
  hideNavAndFooter={true}
>
  <div class="min-h-[85vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 bg-[#FBFBF9]">
    <div class="max-w-md w-full bg-white p-8 sm:p-10 border border-[#E8E5DC] rounded-sm shadow-md space-y-6">
      
      <div class="text-center space-y-2">
        <div class="w-12 h-12 mx-auto bg-[#141311] text-[#FBFBF9] rounded-sm flex items-center justify-center font-serif text-2xl font-bold mb-3 shadow-xs">
          D
        </div>
        <span class="text-xs uppercase tracking-[0.24em] text-[#9B4722] font-semibold block">
          Restricted Curatorial Access
        </span>
        <h1 class="font-serif-display text-3xl sm:text-4xl text-[#141311] font-medium">
          Studio CMS Portal
        </h1>
        <p class="text-xs text-[#6B6864] leading-relaxed">
          Authorized studio administration only. Sign in to manage artworks, exhibitions, and collector inquiries.
        </p>
      </div>

      <!-- Security Notice & Error Alert -->
      <div id="login-error" class="hidden p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-sm space-y-1">
        <span class="font-semibold block" id="error-title">Authentication Failed</span>
        <span id="error-desc" class="text-[11px] block">Invalid credentials. Please verify your email and passkey.</span>
      </div>

      <form id="admin-login-form" class="space-y-4" autocomplete="on">
        <div>
          <label for="admin-email" class="block text-xs uppercase tracking-wider text-[#57544E] mb-1 font-medium">
            Owner / Curator Email
          </label>
          <input
            type="email"
            id="admin-email"
            name="email"
            required
            autocomplete="email"
            placeholder="studio@dhirendra-art.com"
            class="w-full px-3.5 py-2.5 text-sm bg-[#FBFBF9] border border-[#D3CEBF] rounded-sm focus:outline-none focus:ring-1 focus:ring-[#9B4722] transition-colors"
          />
        </div>

        <div>
          <label for="admin-password" class="block text-xs uppercase tracking-wider text-[#57544E] mb-1 font-medium">
            Password / Studio Passkey
          </label>
          <input
            type="password"
            id="admin-password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="Enter studio passkey"
            class="w-full px-3.5 py-2.5 text-sm bg-[#FBFBF9] border border-[#D3CEBF] rounded-sm focus:outline-none focus:ring-1 focus:ring-[#9B4722] transition-colors"
          />
        </div>

        <div class="pt-2">
          <button
            type="submit"
            id="login-btn"
            class="w-full py-3 bg-[#141311] hover:bg-[#2C2A26] text-[#FBFBF9] text-xs uppercase tracking-[0.2em] font-medium transition-colors rounded-sm shadow-xs disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Authenticate &rarr;
          </button>
        </div>
      </form>

      <div class="pt-4 border-t border-[#F0ECE3] text-center">
        <a
          href="/"
          class="text-xs text-[#8A857D] hover:text-[#141311] transition-colors uppercase tracking-wider font-medium"
        >
          &larr; Return to Public Gallery
        </a>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  import { isSupabaseConfigured, supabase } from '../../lib/supabase';
  import { setStudioAdminLoggedIn } from '../../lib/cmsStorage';

  const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('admin-email') as HTMLInputElement | null;
  const passwordInput = document.getElementById('admin-password') as HTMLInputElement | null;
  const errorBox = document.getElementById('login-error');
  const errorDesc = document.getElementById('error-desc');
  const loginBtn = document.getElementById('login-btn') as HTMLButtonElement | null;

  // Rate Limiting / Brute Force Prevention (OWASP ASVS V2.2)
  let failedAttempts = 0;
  let lockoutTimer: number | null = null;

  async function sha256(text: string): Promise<string> {
    const encoder = new TextEncoder();
    const data = encoder.encode(text);
    const hashBuffer = await crypto.subtle.digest('SHA-256', data);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map((b) => b.toString(16).padStart(2, '0')).join('');
  }

  // Precomputed hash of default studio passkey for offline/standalone mode verification
  const EXPECTED_HASH = 'f56b0d912781b4e2865912e75e114681ca0408544a4b9c51a0218f257ef51da4';

  function showError(msg: string) {
    if (errorBox && errorDesc) {
      errorDesc.textContent = msg;
      errorBox.classList.remove('hidden');
    }
  }

  function hideError() {
    if (errorBox) {
      errorBox.classList.add('hidden');
    }
  }

  if (form && emailInput && passwordInput && loginBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();

      if (lockoutTimer && Date.now() < lockoutTimer) {
        const remaining = Math.ceil((lockoutTimer - Date.now()) / 1000);
        showError(`Too many failed attempts. Access locked for ${remaining} seconds.`);
        return;
      }

      const email = emailInput.value.trim().toLowerCase();
      const password = passwordInput.value;

      if (!email || !password) {
        showError('Please provide both your curator email and passkey.');
        return;
      }

      loginBtn.disabled = true;
      loginBtn.textContent = 'Authenticating...';

      try {
        let authenticated = false;

        // 1. If Supabase is configured, use secure Supabase Auth
        if (isSupabaseConfigured && supabase) {
          const { error } = await supabase.auth.signInWithPassword({ email, password });
          if (!error) {
            authenticated = true;
          }
        }

        // 2. Standalone hash verification fallback
        if (!authenticated) {
          const inputHash = await sha256(password);
          if (inputHash === EXPECTED_HASH) {
            authenticated = true;
          }
        }

        if (authenticated) {
          failedAttempts = 0;
          setStudioAdminLoggedIn(true);
          window.location.href = '/admin/dashboard';
        } else {
          failedAttempts++;
          if (failedAttempts >= 5) {
            lockoutTimer = Date.now() + 60000; // 60-second lockout
            showError('Account locked due to consecutive failed attempts. Please wait 60 seconds.');
          } else {
            showError(`Invalid email or passkey. (${5 - failedAttempts} attempts remaining)`);
          }
        }
      } catch (err) {
        showError('Authentication service temporarily unavailable. Please try again.');
      } finally {
        loginBtn.disabled = false;
        loginBtn.textContent = 'Authenticate →';
      }
    });
  }
</script>
