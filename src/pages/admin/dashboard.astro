---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllArtworks } from '../../lib/artworks';
import { getBids } from '../../lib/bids';
import { getAllOrders } from '../../lib/orders';
import { getEnquiries } from '../../lib/enquiries';

const artworks = await getAllArtworks();
const bids = await getBids();
const orders = await getAllOrders();
const enquiries = await getEnquiries();

const totalArtworks = artworks.length;
const availableArtworks = artworks.filter((a) => a.availability === 'AVAILABLE').length;
const soldArtworks = artworks.filter((a) => a.availability === 'SOLD').length;
const pendingOffers = bids.filter((b) => b.status === 'PENDING').length;
const acceptedOffers = bids.filter((b) => b.status === 'ACCEPTED').length;
const activeOrders = orders.filter((o) => o.order_status !== 'DELIVERED' && o.order_status !== 'CANCELLED').length;
const newEnquiries = enquiries.filter((e) => e.status === 'NEW').length;
---

<BaseLayout
  title="Studio CMS Dashboard — Dhirendra Art Gallery"
  description="Administrative management of catalogue artworks, offers, orders, and studio inquiries."
>
  <div class="py-12 sm:py-16 bg-[#FBFBF9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-8 border-b border-[#E8E5DC] gap-4">
        <div>
          <span class="text-xs uppercase tracking-[0.2em] text-[#9B4722] font-semibold block">
            Studio CMS &bull; Portal
          </span>
          <h1 class="font-serif-display text-4xl sm:text-5xl text-[#141311] font-medium mt-1">
            Curatorial Dashboard
          </h1>
          <p class="text-xs text-[#6B6864] mt-1">
            Logged in as Studio Administrator &bull; Dhirendra Fine Art Practice
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/gallery"
            target="_blank"
            class="px-4 py-2 border border-[#141311] text-xs uppercase tracking-wider text-[#141311] hover:bg-[#141311] hover:text-[#FBFBF9] transition-colors"
          >
            Live Gallery &nearr;
          </a>
          <a
            href="/admin/login"
            class="px-4 py-2 text-xs uppercase tracking-wider text-[#8A857D] hover:text-[#141311] transition-colors"
          >
            Sign Out
          </a>
        </div>
      </div>

      <!-- KPI Metrics Grid (As specified in Section 21) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-4 my-8">
        <div class="p-4 bg-white border border-[#E8E5DC] rounded-sm">
          <span class="text-[10px] uppercase tracking-wider text-[#8A857D] block">Total Artworks</span>
          <span class="font-serif text-3xl font-bold text-[#141311]">{totalArtworks}</span>
        </div>

        <div class="p-4 bg-white border border-[#E8E5DC] rounded-sm">
          <span class="text-[10px] uppercase tracking-wider text-[#8A857D] block">Available</span>
          <span class="font-serif text-3xl font-bold text-green-700">{availableArtworks}</span>
        </div>

        <div class="p-4 bg-white border border-[#E8E5DC] rounded-sm">
          <span class="text-[10px] uppercase tracking-wider text-[#8A857D] block">Sold / Acquired</span>
          <span class="font-serif text-3xl font-bold text-[#8A857D]">{soldArtworks}</span>
        </div>

        <div class="p-4 bg-white border border-[#E8E5DC] rounded-sm">
          <span class="text-[10px] uppercase tracking-wider text-[#8A857D] block">Pending Offers</span>
          <span class="font-serif text-3xl font-bold text-[#B68B35]">{pendingOffers}</span>
        </div>

        <div class="p-4 bg-white border border-[#E8E5DC] rounded-sm">
          <span class="text-[10px] uppercase tracking-wider text-[#8A857D] block">Accepted Offers</span>
          <span class="font-serif text-3xl font-bold text-[#141311]">{acceptedOffers}</span>
        </div>

        <div class="p-4 bg-white border border-[#E8E5DC] rounded-sm">
          <span class="text-[10px] uppercase tracking-wider text-[#8A857D] block">Active Orders</span>
          <span class="font-serif text-3xl font-bold text-[#9B4722]">{activeOrders}</span>
        </div>

        <div class="p-4 bg-white border border-[#E8E5DC] rounded-sm col-span-2 sm:col-span-1">
          <span class="text-[10px] uppercase tracking-wider text-[#8A857D] block">New Inquiries</span>
          <span class="font-serif text-3xl font-bold text-[#141311]">{newEnquiries}</span>
        </div>
      </div>

      <!-- Section Tabs & Content -->
      <div class="space-y-12">
        
        <!-- 1. Bids & Offers Management (PRD Section 23) -->
        <section class="bg-white border border-[#E8E5DC] rounded-sm p-6 sm:p-8">
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-[#E8E5DC]">
            <div>
              <h2 class="font-serif-display text-2xl text-[#141311] font-medium">
                Collector Offers & Bids
              </h2>
              <p class="text-xs text-[#6B6864]">Proposals submitted by collectors for designated artworks.</p>
            </div>
            <span class="text-xs font-mono text-[#B68B35] font-semibold">{bids.length} Total</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-[#FBFBF9] uppercase tracking-wider text-[#8A857D] border-b border-[#E8E5DC]">
                <tr>
                  <th class="p-3">Artwork</th>
                  <th class="p-3">Collector Name</th>
                  <th class="p-3">Contact</th>
                  <th class="p-3">Offer Amount</th>
                  <th class="p-3">Message</th>
                  <th class="p-3">Status</th>
                  <th class="p-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#F0ECE3]">
                {bids.map((bid) => (
                  <tr class="hover:bg-[#FDFCFB]">
                    <td class="p-3 font-medium text-[#141311]">{bid.artwork_title || bid.artwork_id}</td>
                    <td class="p-3">{bid.name}</td>
                    <td class="p-3 text-[#6B6864]">
                      <div>{bid.email}</div>
                      <div class="font-mono text-[11px]">{bid.phone}</div>
                    </td>
                    <td class="p-3 font-serif font-bold text-sm text-[#141311]">
                      ₹{bid.offer_amount.toLocaleString('en-IN')}
                    </td>
                    <td class="p-3 text-[#57544E] max-w-xs truncate">{bid.message || '—'}</td>
                    <td class="p-3">
                      <span class={`px-2 py-0.5 rounded-sm font-medium text-[10px] uppercase tracking-wider ${
                        bid.status === 'ACCEPTED'
                          ? 'bg-green-100 text-green-800'
                          : bid.status === 'PENDING'
                          ? 'bg-yellow-100 text-yellow-800'
                          : 'bg-gray-100 text-gray-700'
                      }`}>
                        {bid.status}
                      </span>
                    </td>
                    <td class="p-3 text-right space-x-2">
                      <button
                        type="button"
                        class="px-2.5 py-1 bg-[#141311] text-[#FBFBF9] hover:bg-[#2C2A26] rounded-sm text-[10px] uppercase tracking-wider"
                      >
                        Accept
                      </button>
                      <button
                        type="button"
                        class="px-2.5 py-1 border border-[#D3CEBF] text-[#57544E] hover:bg-gray-50 rounded-sm text-[10px] uppercase tracking-wider"
                      >
                        Reject
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- 2. Orders & Shipments Management (PRD Section 24) -->
        <section class="bg-white border border-[#E8E5DC] rounded-sm p-6 sm:p-8">
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-[#E8E5DC]">
            <div>
              <h2 class="font-serif-display text-2xl text-[#141311] font-medium">
                Active Orders & Consignments
              </h2>
              <p class="text-xs text-[#6B6864]">Consignments in preparation, crating, transit, and delivery.</p>
            </div>
            <a
              href="/order-tracking"
              class="text-xs text-[#9B4722] hover:underline"
            >
              Public Tracker View &rarr;
            </a>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-[#FBFBF9] uppercase tracking-wider text-[#8A857D] border-b border-[#E8E5DC]">
                <tr>
                  <th class="p-3">Order Number</th>
                  <th class="p-3">Collector</th>
                  <th class="p-3">Artwork</th>
                  <th class="p-3">Valuation</th>
                  <th class="p-3">Current Status</th>
                  <th class="p-3">Courier Logistics</th>
                  <th class="p-3 text-right">Update Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#F0ECE3]">
                {orders.map((ord) => (
                  <tr class="hover:bg-[#FDFCFB]">
                    <td class="p-3 font-mono font-semibold text-[#141311]">{ord.order_number}</td>
                    <td class="p-3">
                      <div class="font-medium text-[#141311]">{ord.customer_name}</div>
                      <div class="text-[#8A857D] text-[11px]">{ord.customer_email}</div>
                    </td>
                    <td class="p-3">{ord.artwork?.title || ord.artwork_id}</td>
                    <td class="p-3 font-serif font-bold text-[#141311]">₹{ord.amount.toLocaleString('en-IN')}</td>
                    <td class="p-3">
                      <span class="px-2 py-0.5 bg-[#FAF5E9] text-[#9B4722] font-semibold rounded-sm text-[10px] uppercase tracking-wider">
                        {ord.order_status.replace('_', ' ')}
                      </span>
                    </td>
                    <td class="p-3 text-[#6B6864]">
                      <div>{ord.tracking_courier || 'Pending Carrier Handover'}</div>
                      {ord.tracking_number && <div class="font-mono text-[11px] text-[#8A857D]">{ord.tracking_number}</div>}
                    </td>
                    <td class="p-3 text-right">
                      <select
                        aria-label={`Update status for ${ord.order_number}`}
                        class="px-2 py-1 bg-white border border-[#D3CEBF] text-[11px] rounded-sm"
                      >
                        <option value="PREPARING_ARTWORK">Preparing Artwork</option>
                        <option value="PACKED">Packed</option>
                        <option value="SHIPPED">Shipped</option>
                        <option value="DELIVERED">Delivered</option>
                      </select>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- 3. Catalogue Artworks Management (PRD Section 22) -->
        <section class="bg-white border border-[#E8E5DC] rounded-sm p-6 sm:p-8">
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-[#E8E5DC]">
            <div>
              <h2 class="font-serif-display text-2xl text-[#141311] font-medium">
                Artwork Catalogue Inventory
              </h2>
              <p class="text-xs text-[#6B6864]">Manage artwork records, medium specifications, prices, and signature marks.</p>
            </div>
            <button
              type="button"
              class="px-4 py-2 bg-[#141311] text-[#FBFBF9] hover:bg-[#2C2A26] text-xs uppercase tracking-wider font-medium"
            >
              + Create New Artwork
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {artworks.map((art) => (
              <div class="border border-[#E8E5DC] rounded-sm p-3 bg-[#FBFBF9] flex flex-col justify-between space-y-3">
                <div class="aspect-[4/5] overflow-hidden bg-[#E8E5DC] rounded-sm">
                  <img
                    src={art.images[0]?.storage_path}
                    alt={art.title}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="space-y-1">
                  <div class="flex items-center justify-between text-[11px]">
                    <span class="text-[#8A857D]">{art.category}</span>
                    <span class="font-mono text-[#8A857D]">{art.year}</span>
                  </div>
                  <h3 class="font-serif-display text-lg text-[#141311] font-medium truncate">
                    {art.title}
                  </h3>
                  <p class="text-[11px] text-[#57544E] italic truncate">{art.medium}</p>
                  <div class="pt-2 flex items-center justify-between text-xs">
                    <span class="font-medium text-[#141311]">
                      {art.price ? `₹${art.price.toLocaleString('en-IN')}` : 'Offer Based'}
                    </span>
                    <span class={`text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-sm ${
                      art.availability === 'AVAILABLE' ? 'bg-green-100 text-green-800' : 'bg-gray-200 text-gray-700'
                    }`}>
                      {art.availability}
                    </span>
                  </div>
                </div>
                <div class="pt-2 border-t border-[#E8E5DC] flex items-center justify-between text-xs">
                  <a
                    href={`/gallery/${art.slug}`}
                    target="_blank"
                    class="text-[#9B4722] hover:underline text-[11px]"
                  >
                    View Page &nearr;
                  </a>
                  <button class="text-[#57544E] hover:text-[#141311] text-[11px]">
                    Edit &rarr;
                  </button>
                </div>
              </div>
            ))}
          </div>
        </section>

      </div>

    </div>
  </div>
</BaseLayout>
