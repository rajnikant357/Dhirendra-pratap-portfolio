---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdminPortal } from '../../components/admin/AdminPortal';
import { getAllArtworks } from '../../lib/artworks';
import { PROJECTS_DATA } from '../../lib/data/projects';
import { ACHIEVEMENTS_DATA } from '../../lib/data/achievements';
import { isSupabaseConfigured } from '../../lib/supabase';

// Only public catalogue data is passed at build time.
// Sensitive datasets (bids, orders, collector inquiries) are loaded strictly client-side after session verification.
const artworks = await getAllArtworks();
---

<BaseLayout
  title="Dhirendra Studio CMS — Curatorial & Portfolio Content Management Portal"
  description="Administrative portal for Dhirendra to upload artworks, curate collections, manage orders, and update honors."
  hideNavAndFooter={true}
>
  <AdminPortal
    client:only="react"
    initialArtworks={artworks}
    initialBids={[]}
    initialOrders={[]}
    initialEnquiries={[]}
    initialProjects={PROJECTS_DATA}
    initialAchievements={ACHIEVEMENTS_DATA}
    isSupabaseConnected={isSupabaseConfigured}
  />
</BaseLayout>
