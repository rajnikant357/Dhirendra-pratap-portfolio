---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AboutDynamicSections } from '../components/about/AboutDynamicSections';
import { ACHIEVEMENTS_DATA } from '../lib/data/achievements';
import { PROJECTS_DATA } from '../lib/data/projects';
---

<BaseLayout
  title="The Journey of Dhirendra — Artist & Graphics Designer | Biography & Philosophy"
  description="Biography, education (BVA, MVA), awards, and artistic philosophy of Dhirendra, visual artist and graphics designer with over seven years of dedicated studio practice."
>
  <div class="py-16 sm:py-24 bg-[#FBFBF9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- 1. Hero: The Journey of Dhirendra -->
      <section class="max-w-4xl space-y-6 pb-16 border-b border-[#E8E5DC]">
        <span class="text-xs uppercase tracking-[0.24em] text-[#9B4722] font-semibold block">
          Curatorial Biography
        </span>
        <h1 class="font-serif-display text-5xl sm:text-7xl text-[#141311] font-medium tracking-tight leading-[0.98]">
          The Journey of Dhirendra
        </h1>
        <p id="cms-about-quote" class="font-serif text-2xl sm:text-3xl text-[#57544E] italic leading-relaxed">
          "Art is not an ornament on the surface of reality; it is an investigation into the silence beneath everyday observation."
        </p>
      </section>

      <!-- 2. Dual Column: Artist Portrait & Detailed Biography -->
      <section class="py-16 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start border-b border-[#E8E5DC]">
        
        <!-- Left: Studio Image & Credentials Box -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white p-4 rounded-sm border border-[#E8E5DC] shadow-sm">
            <div class="aspect-[4/5] bg-[#F0ECE3] overflow-hidden rounded-sm">
              <picture>
                <source srcset="/photos/Dhirendra.webp" type="image/webp" />
                <img
                  id="cms-about-portrait"
                  src="/photos/Dhirendra.jpeg"
                  alt="Dhirendra Pratap — Artist and Graphic Designer"
                  width="400"
                  height="500"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
              </picture>
            </div>
            <div class="pt-4 text-center">
              <span class="font-serif-display text-2xl text-[#141311] font-medium block">Dhirendra Pratap</span>
              <span class="text-xs uppercase tracking-[0.2em] text-[#9B4722] font-medium">Artist & Graphics Designer</span>
            </div>
          </div>

          <!-- Academic Credential Box -->
          <div class="p-6 bg-[#FAF5E9] border border-[#E8E5DC] rounded-sm space-y-4">
            <h2 class="text-xs uppercase tracking-[0.2em] text-[#141311] font-semibold">
              Academic Foundation
            </h2>
            <div class="space-y-3 text-xs">
              <div class="pb-2 border-b border-[#E8E5DC]">
                <strong class="text-sm font-serif block text-[#141311]">Master of Visual Arts (MVA)</strong>
                <span class="text-[#57544E]">Faculty of Fine Arts, University of Lucknow</span>
                <span class="block text-[#8A857D] font-mono mt-0.5">Postgraduate Specialization in Painting</span>
              </div>
              <div class="pb-2 border-b border-[#E8E5DC]">
                <strong class="text-sm font-serif block text-[#141311]">Bachelor of Visual Arts (BVA)</strong>
                <span class="text-[#57544E]">Faculty of Fine Arts, University of Lucknow</span>
                <span class="block text-[#8A857D] font-mono mt-0.5">Fine Arts, Drawing & Visual Composition</span>
              </div>
              <div>
                <strong class="text-sm font-serif block text-[#141311]">State Lalit Kala Akademi Workshop (2012)</strong>
                <span class="text-[#57544E]">Summer Art Workshop, Ballia, Uttar Pradesh</span>
                <span class="block text-[#8A857D] font-mono mt-0.5">Early Foundation Training</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Biography & Artistic Practice -->
        <div class="lg:col-span-7 space-y-8">
          <div class="space-y-4 text-base text-[#57544E] leading-relaxed">
            <h2 class="font-serif-display text-3xl text-[#141311] font-medium">
              Biography & Practice
            </h2>
            <div id="cms-about-bio" class="space-y-4">
              <p>
                Dhirendra Pratap is an accomplished Indian visual artist and graphic designer whose practice spans over seven years of dedicated studio work, monumental public murals, and civic installations. Born in Badagaon Khadsara, Ballia, Uttar Pradesh, his artistic development was shaped by early foundational training under the State Lalit Kala Akademi in 2012, followed by rigorous academic study at the Faculty of Fine Arts, University of Lucknow.
              </p>
              <p>
                Holding both Bachelor of Visual Arts (BVA) and Master of Visual Arts (MVA) degrees with a specialization in Painting from the University of Lucknow, Dhirendra works fluidly across traditional canvas painting, observational portraiture, large-scale outdoor wall murals, intricate ceremonial rangoli, and upcycled scrap metal sculptures.
              </p>
              <p>
                His accomplishments have received prominent state and regional recognitions, including the State Lalit Kala Akademi National Exhibition (2022), Uttar Pradesh Kala Ratna Samman (2020), Kala Shree Samman (2020), Shan-e-Siddharth Samman (2021), and multiple ceremonial presentations for Uttar Pradesh Chief Minister Yogi Adityanath.
              </p>
            </div>
          </div>

          <!-- Artistic Philosophy in the Artist's Own Words -->
          <div class="p-8 bg-[#F4F1EA] border-l-4 border-[#9B4722] space-y-3">
            <span class="text-xs uppercase tracking-[0.2em] text-[#9B4722] font-semibold block">
              Artistic Philosophy
            </span>
            <p class="font-serif text-lg sm:text-xl text-[#141311] italic leading-relaxed">
              "Art is not an ornament on the surface of reality; it is an investigation into the silence beneath everyday observation. Every stroke on canvas or texture in scrap metal is an act of patient listening."
            </p>
            <span class="text-xs uppercase tracking-wider text-[#8A857D] font-medium block">
              &mdash; Dhirendra Pratap
            </span>
          </div>

          <!-- Studio Approach -->
          <div class="space-y-3 text-sm text-[#57544E]">
            <h3 class="font-serif-display text-2xl text-[#141311] font-medium">
              Materiality & Method
            </h3>
            <p class="leading-relaxed">
              Dhirendra's studio practice balances fine art discipline with material innovation. On canvas and paper, he utilizes oils, acrylics, graphite, and mineral pigments with archival preparation. In the public sphere, his practice extends to weather-resistant outdoor mural emulsions, floral and powdered pigments for ceremonial rangoli, and discarded industrial metal scrap welded into life-sized animal and civic sculptures.
            </p>
          </div>
        </div>

      </section>

      <!-- 3. Visual Career Timeline -->
      <section class="py-16 border-b border-[#E8E5DC]">
        <div class="max-w-3xl mb-12">
          <span class="text-xs uppercase tracking-[0.22em] text-[#B68B35] font-semibold block">
            Milestones
          </span>
          <h2 class="font-serif-display text-4xl text-[#141311] font-medium mt-1">
            Artistic Journey &amp; Milestones
          </h2>
          <p class="text-sm text-[#57544E] mt-2">
            A comprehensive chronology of academic rigor, national academy workshops, state honors, and monumental public commissions.
          </p>
        </div>

        <div class="relative border-l-2 border-[#E8E5DC] ml-4 sm:ml-24 space-y-10 pl-6 sm:pl-10">

          <div class="relative">
            <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#141311] border-4 border-white"></span>
            <span class="font-mono text-xs text-[#9B4722]">2015–2021 &bull; Academic Foundation (BVA &amp; MVA)</span>
            <h3 class="font-serif-display text-xl text-[#141311] font-medium mt-0.5">Department of Fine Arts, University of Lucknow</h3>
            <p class="text-xs text-[#57544E] mt-1">Formal BVA &amp; MVA specialization in Painting at Lucknow University Faculty of Fine Arts. Mastered anatomy, drawing, and classical composition; trained in digital visual media with Taxtron (2017) and led public environmental art for Climate Agenda's 'Clean Air Gomti' campaign (2018).</p>
          </div>

          <div class="relative">
            <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#B68B35] border-4 border-white"></span>
            <span class="font-mono text-xs text-[#B68B35]">2020 &bull; Frontline Public Art &amp; State Accolades</span>
            <h3 class="font-serif-display text-xl text-[#141311] font-medium mt-0.5">UP Kala Ratna &amp; Kala Shree Samman</h3>
            <p class="text-xs text-[#57544E] mt-1">Conferred the prestigious Uttar Pradesh Kala Ratna Samman and Kala Shree Samman. Executed high-profile street rangolis and murals at Mankameshwar, Hazratganj, and Raj Bhavan honoring COVID frontline workers; felicitated by North Lucknow ACP Sonam Kumar and UP Police.</p>
          </div>

          <div class="relative">
            <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#B68B35] border-4 border-white"></span>
            <span class="font-mono text-xs text-[#B68B35]">2021 &bull; Regional Recognition</span>
            <h3 class="font-serif-display text-xl text-[#141311] font-medium mt-0.5">Shan-e-Siddharth Samman &amp; Kala Parv Honors</h3>
            <p class="text-xs text-[#57544E] mt-1">Conferred Shan-e-Siddharth citation at Kapilvastu Mahotsav and Kala Parv distinction for exceptional contributions to regional and classical visual arts.</p>
          </div>

          <div class="relative">
            <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#B68B35] border-4 border-white"></span>
            <span class="font-mono text-xs text-[#B68B35]">2022 &bull; Apex National Workshop &amp; University Map</span>
            <h3 class="font-serif-display text-xl text-[#141311] font-medium mt-0.5">Lalit Kala Akademi National Workshop &amp; South Asia Wall Map</h3>
            <p class="text-xs text-[#57544E] mt-1">Selected for the Lalit Kala Akademi Regional Centre Lucknow 'Har Ghar Tiranga' National Painting Workshop (Ministry of Culture, Govt. of India). Awarded official appreciation by the Dean &amp; HoD of Western History, University of Lucknow, for hand-painting the monumental South Asia Historical Wall Map.</p>
          </div>

          <div class="relative">
            <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#9B4722] border-4 border-white"></span>
            <span class="font-mono text-xs text-[#9B4722]">2023–2024 &bull; Civic Murals, Scrap Sculptures &amp; CM Honors</span>
            <h3 class="font-serif-display text-xl text-[#141311] font-medium mt-0.5">Ayodhya Ramayana Murals, Scrap Lion &amp; CM Presentations</h3>
            <p class="text-xs text-[#57544E] mt-1">Executed monumental Ramayana heritage murals in Ayodhya and civic corridors. Fabricated landmark eco-sculptures from industrial automotive scrap (including the life-sized Scrap Lion and Transformer Robot). Presented commissioned portraits directly to Hon'ble UP Chief Minister Yogi Adityanath.</p>
          </div>

          <div class="relative">
            <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#141311] border-4 border-white"></span>
            <span class="font-mono text-xs text-[#141311]">Present &bull; Nationwide Studio Practice</span>
            <h3 class="font-serif-display text-xl text-[#141311] font-medium mt-0.5">Architectural Murals, Bespoke Sculptures &amp; Brand Direction</h3>
            <p class="text-xs text-[#57544E] mt-1">Directing a full-time studio executing architectural exterior murals, eco-metal sculptures, 3D foam installations, ceremonial floor rangolis, and brand graphics for governmental agencies, corporate clients, and art collectors across India.</p>
          </div>
        </div>
      </section>

      <!-- Dynamic Recognitions & Projects Section (Live Synced with Studio CMS) -->
      <div class="pt-16">
        <AboutDynamicSections
          client:visible
          initialAchievements={ACHIEVEMENTS_DATA}
          initialProjects={PROJECTS_DATA}
        />
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  import { getSiteContent } from '../lib/cmsStorage';
  function applyAboutContent() {
    try {
      const content = getSiteContent();
      const quoteEl = document.getElementById('cms-about-quote');
      const bioEl = document.getElementById('cms-about-bio');
      const portraitImg = document.getElementById('cms-about-portrait') as HTMLImageElement;

      if (quoteEl && content.aboutQuote) quoteEl.textContent = content.aboutQuote;
      if (bioEl && content.aboutBio) {
        bioEl.innerHTML = `<p>${content.aboutBio.replace(/\\n/g, '</p><p>')}</p>`;
      }
      if (portraitImg && content.aboutPortraitImage) {
        portraitImg.src = content.aboutPortraitImage;
      }
    } catch (e) {}
  }
  applyAboutContent();
  window.addEventListener('dhirendra_cms_updated', applyAboutContent);
</script>
