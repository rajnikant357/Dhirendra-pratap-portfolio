---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ContactForm } from '../components/forms/ContactForm';
---

<BaseLayout
  title="Contact & Inquiries — Dhirendra | Artist & Graphics Designer"
  description="Initiate artwork acquisition inquiries, bespoke commissions, exhibition invitations, or graphic design projects directly with Dhirendra."
>
  <div class="py-16 sm:py-24 bg-[#FBFBF9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        
        <!-- Left: Studio Details & Curatorial Consultation Info -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <span class="text-xs uppercase tracking-[0.24em] text-[#9B4722] font-semibold block">
              Studio Communication
            </span>
            <h1 class="font-serif-display text-4xl sm:text-5xl text-[#141311] font-medium mt-1">
              Let's Create Something Meaningful
            </h1>
            <p class="text-sm text-[#57544E] mt-3 leading-relaxed">
              We welcome dialogue with collectors, gallerists, cultural institutions, and commercial clients seeking original fine art, curated commissions, or graphic design direction.
            </p>
          </div>

          <!-- Instant Lead Generation & Direct Contact Actions -->
          <div class="p-6 bg-white border border-[#E8E5DC] rounded-sm space-y-4 shadow-sm">
            <div class="flex items-center justify-between border-b border-[#F0ECE3] pb-3">
              <span class="text-xs uppercase tracking-[0.2em] text-[#9B4722] font-bold">
                Instant Direct Dialogue
              </span>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-[10px] font-semibold uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                Open for Work
              </span>
            </div>

            <p class="text-xs text-[#57544E] leading-relaxed">
              For urgent commissions, on-site civic murals, ceremonial rangolis, or freelance graphic design projects, call or message directly:
            </p>

            <div class="space-y-3 pt-1">
              <!-- Call Button -->
              <a
                href="tel:+918115604223"
                class="flex items-center justify-between px-4 py-3 bg-[#141311] hover:bg-[#2C2A26] text-[#FBFBF9] rounded-sm transition-all font-medium group shadow-xs"
              >
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-white/15 flex items-center justify-center text-white shrink-0">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <div class="text-left">
                    <span class="block text-[10px] uppercase tracking-wider text-[#A8A291]">Direct Phone Line</span>
                    <span class="font-mono text-xs sm:text-sm font-bold text-[#FBFBF9]">+91 8115604223</span>
                  </div>
                </div>
                <span class="text-xs uppercase tracking-wider text-[#E5B84B] font-semibold group-hover:translate-x-1 transition-transform">
                  Call &rarr;
                </span>
              </a>

              <!-- WhatsApp Chat Button -->
              <a
                href="https://wa.me/918115604223?text=Hello%20Dhirendra,%20I%20am%20interested%20in%20discussing%20an%20art%20commission%20/%20freelance%20project."
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between px-4 py-3 bg-[#25D366] hover:bg-[#20bd5a] text-white rounded-sm transition-all font-medium group shadow-xs"
              >
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center text-white shrink-0">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                    </svg>
                  </div>
                  <div class="text-left">
                    <span class="block text-[10px] uppercase tracking-wider text-white/80">WhatsApp Direct</span>
                    <span class="font-mono text-xs sm:text-sm font-bold text-white">+91 8115604223</span>
                  </div>
                </div>
                <span class="text-xs uppercase tracking-wider text-white font-semibold group-hover:translate-x-1 transition-transform">
                  Chat &rarr;
                </span>
              </a>

              <!-- Instagram Social Link -->
              <a
                href="https://instagram.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between px-4 py-3 bg-[#FBFBF9] hover:bg-white border border-[#E8E5DC] text-[#141311] rounded-sm transition-all font-medium group"
              >
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-amber-500 via-pink-500 to-purple-600 flex items-center justify-center text-white shrink-0">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  </div>
                  <div class="text-left">
                    <span class="block text-[10px] uppercase tracking-wider text-[#8A857D]">Official Instagram</span>
                    <span class="text-xs font-semibold text-[#141311]">Follow &amp; Direct Message</span>
                  </div>
                </div>
                <span class="text-xs uppercase tracking-wider text-[#9B4722] font-semibold group-hover:translate-x-1 transition-transform">
                  Follow &rarr;
                </span>
              </a>
            </div>
          </div>

          <!-- Studio Hours & Response Policy -->
          <div class="p-6 bg-white border border-[#E8E5DC] rounded-sm space-y-4">
            <h3 class="text-xs uppercase tracking-[0.2em] text-[#141311] font-semibold">
              Curatorial Protocol
            </h3>
            <ul class="space-y-3 text-xs text-[#57544E]">
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#B68B35] mt-1.5 flex-shrink-0"></span>
                <span><strong>Acquisition Inquiries:</strong> Direct response within 24 to 48 hours with high-res condition reports.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#B68B35] mt-1.5 flex-shrink-0"></span>
                <span><strong>Private &amp; Public Commissions:</strong> Concept sketches, material specifications, and timeline estimates provided upon consultation.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#B68B35] mt-1.5 flex-shrink-0"></span>
                <span><strong>Freelance Design &amp; Art:</strong> Commercial graphic identity, typography, set design, and production consulting.</span>
              </li>
            </ul>
          </div>

          <!-- Studio Direct Contact Details -->
          <div class="space-y-2 text-xs text-[#57544E]">
            <h4 class="uppercase tracking-wider text-[#141311] font-semibold">Studio &amp; Location Details</h4>
            <p>Based in Uttar Pradesh, India &bull; Available for on-site public art commissions nationwide and international consignment shipments.</p>
            <p class="pt-2">Direct Phone / WhatsApp: <a href="tel:+918115604223" class="font-mono font-bold text-[#141311] hover:text-[#9B4722]">+91 8115604223</a></p>
            <p>Email: <a href="mailto:dhirendra.artstudio@gmail.com" class="font-medium text-[#141311] hover:underline">dhirendra.artstudio@gmail.com</a></p>
          </div>

          {/* Temporarily hidden: Order Tracking Quick Link
          <div class="p-4 bg-[#FAF5E9] border border-[#E8E5DC] rounded-sm text-xs">
            <span class="font-semibold text-[#141311] block mb-1">Already acquired an artwork?</span>
            <p class="text-[#57544E] mb-2">Track the crating and transit status of your consignment in real time.</p>
            <a
              href="/order-tracking"
              class="text-[#9B4722] font-semibold uppercase tracking-wider text-[11px] underline underline-offset-4 hover:text-[#7D3516]"
            >
              Go to Order Tracking Console &rarr;
            </a>
          </div>
          */}
        </div>

        <!-- Right: The Inquiry Form React Island -->
        <div class="lg:col-span-7 bg-white p-6 sm:p-10 border border-[#E8E5DC] rounded-sm shadow-sm">
          <ContactForm client:idle />
        </div>

      </div>

    </div>
  </div>
</BaseLayout>
